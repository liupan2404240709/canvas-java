<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.infinitecanvas.canvas.mapper.AssetMapper">

    <!-- 标签聚合。
         JSON_TABLE 是 MySQL 8 才有的"把 JSON 数组展开成行"的表函数：
           ["人像","暖色"]  →  两行 (人像) (暖色)
         展开之后再 group by，就得到每个标签被多少条素材用过。

         为什么不用关联表 t_asset_tag：
         1. 标签是弱结构，改动频繁，关联表意味着每次改标签都要 diff 增删；
         2. 这个项目没有"按标签反查素材总数做分页"的性能压力，
            JSON_CONTAINS 在小数据量下够用。
         如果哪天标签要做成独立实体（重命名、颜色、排序），就应该拆表。 -->
    <select id="selectTagCounts" resultType="com.infinitecanvas.canvas.vo.TagCountVO">
        SELECT jt.tag AS tag, COUNT(*) AS `count`
        FROM t_asset a
                 JOIN JSON_TABLE (a.tags_json, '$[*]' COLUMNS (tag VARCHAR(64) PATH '$')) jt
        WHERE a.user_id = #{userId}
          AND a.deleted = 0
          AND a.tags_json IS NOT NULL
        GROUP BY jt.tag
        ORDER BY `count` DESC, jt.tag ASC
        LIMIT #{limit}
    </select>
</mapper>
